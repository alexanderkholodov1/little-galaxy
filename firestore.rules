rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && uid == request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function objectPath(id) { return /databases/$(database)/documents/objects/$(id); }
    function eventPath(id) { return /databases/$(database)/documents/events/$(id); }
    function config() { return get(/databases/$(database)/documents/config/live).data; }
    function afterUser() { return getAfter(userPath()).data; }
    function numberIn(n, low, high) { return n is number && n >= low && n <= high; }
    function id(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function paletteIndex(n) { return n is int && n >= 0 && n <= 3; }
    function params(p, type, version) {
      return p is map && numberIn(p.size, 0.2, 0.7) && (
        (type == 'planet'
          && p.keys().hasAll(version == 1 ? ['size','palette','oceans'] : ['size','palette','oceans','mountains','clouds','rings','atmosphere'])
          && p.keys().hasOnly(version == 1 ? ['size','palette','oceans'] : ['size','palette','oceans','mountains','clouds','rings','atmosphere'])
          && paletteIndex(p.palette) && numberIn(p.oceans,0,1)
          && numberIn(p.get('mountains',0.3),0,1) && numberIn(p.get('clouds',0.3),0,1)
          && numberIn(p.get('rings',0),0,1) && paletteIndex(p.get('atmosphere',0)))
        || (version == 2 && type == 'star' && p.keys().hasAll(['size','temperature','corona'])
          && p.keys().hasOnly(['size','temperature','corona']) && numberIn(p.temperature,0,1) && numberIn(p.corona,0,1))
        || (version == 2 && type == 'moon' && p.keys().hasAll(['size','craters','colour'])
          && p.keys().hasOnly(['size','craters','colour']) && numberIn(p.craters,0,1) && paletteIndex(p.colour)));
    }
    function hostMatches(d) {
      let host = getAfter(objectPath(d.orbit.hostId)).data;
      return d.type == 'planet' ? host.type == 'star' && host.status == 'active'
        : host.type == 'planet' && host.ownerUid in [request.auth.uid, ''] && d.hostOrbit == host.orbit;
    }
    function validHost(d) {
      return d.type == 'star' ? d.orbit.hostId == 'central'
        : d.orbit.hostId == 'central' ? d.type == 'planet' : hostMatches(d);
    }
    function orbit(o) {
      return o.keys().hasAll(['hostId','a','e','inclination','omega','meanAnomaly','epoch','direction','isComet'])
        && o.keys().hasOnly(['hostId','a','e','inclination','omega','meanAnomaly','epoch','direction','isComet'])
        && id(o.hostId) && numberIn(o.a, 3.5, 20.05) && numberIn(o.e, 0, 0.755)
        && o.a * (1 - o.e) > 1 && o.a * (1 + o.e) <= 34.1 && numberIn(o.inclination, -0.35, 0.35)
        && numberIn(o.omega, -3.141592653589793, 3.141592653589793)
        && numberIn(o.meanAnomaly, -3.141592653589793, 3.141592653589793)
        && numberIn(o.epoch, 0, 4102444800000) && o.direction in [-1,1] && o.isComet is bool;
    }
    function freshOrbit(o) {
      return numberIn(o.epoch, request.time.toMillis() - 120000, request.time.toMillis() + 120000);
    }
    function objectSchema(d) {
      return d.keys().hasAll(['schemaVersion','ownerUid','type','nameKey','params','orbit','status','createdAt','updatedAt','season'])
        && d.keys().hasOnly(['schemaVersion','ownerUid','type','nameKey','params','orbit','hostOrbit','status','createdAt','updatedAt','season'])
        && d.schemaVersion in [1,2] && d.ownerUid == request.auth.uid && d.type in ['planet','star','moon']
        && (d.nameKey in ['quiet-aurora','bright-tide','gentle-horizon','distant-garden'] || (d.nameKey is string && d.nameKey.matches('^n[0-3][0-9]-[0-3][0-9]$')))
        && params(d.params,d.type,d.schemaVersion) && orbit(d.orbit)
        && (d.type == 'moon' ? orbit(d.hostOrbit) : !('hostOrbit' in d)) && d.status in ['active','hangar']
        && d.createdAt is timestamp && d.updatedAt == request.time && d.season == 'bad-2026';
    }
    function launchAction(a) { return a in ['launch','relaunch']; }
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function today() { return string(request.time.year()) + '-' + pad(request.time.month()) + '-' + pad(request.time.day()); }
    function eventMatches(eventId, type, objectId) {
      let e = getAfter(eventPath(eventId)).data;
      return e.at == request.time && e.uid == request.auth.uid && e.type == type && e.objectId == objectId;
    }
    function archivedMatches(oldId, writeId) {
      let old = getAfter(objectPath(oldId)).data;
      return old.status == 'hangar' && old.updatedAt == request.time
        && eventMatches(writeId + '-crumble', 'crumble', oldId);
    }
    function activeTransition(d, oldId) {
      let o = getAfter(objectPath(d.activeObjectId)).data;
      return o.ownerUid == request.auth.uid && o.status == 'active' && o.updatedAt == request.time
        && eventMatches(d.writeId, d.action, d.activeObjectId)
        && (oldId == '' || (oldId != d.activeObjectId
          && archivedMatches(oldId, d.writeId)));
    }
    function userSchema(d) {
      return d.keys().hasAll(['schemaVersion','activeObjectId','launchesToday','launchDay','lastWriteAt','lastShakeAt','lastCometAt','lastStarAt','writeId','action'])
        && d.keys().hasOnly(['interactionDay','interactionsToday','editsToday','editDay','schemaVersion','activeObjectId','launchesToday','launchDay','lastWriteAt','lastShakeAt','lastCometAt','lastStarAt','writeId','action'])
        && d.schemaVersion == 1 && (id(d.activeObjectId) || d.activeObjectId == '') && id(d.writeId)
        && d.launchesToday is int && d.launchesToday >= 0 && d.launchesToday <= 5
        && d.launchDay is string && d.lastWriteAt == request.time
        && d.lastShakeAt is timestamp && d.lastCometAt is timestamp && d.lastStarAt is timestamp
        && d.action in ['launch','relaunch','edit','shake','comet','shootingStar'];
    }
    function editBudget(d, old) {
      return d.action == 'edit'
        ? d.get('editDay','') == today()
          && d.get('editsToday',0) is int
          && d.editsToday == (old.get('editDay','') == today() ? old.get('editsToday',0) + 1 : 1)
          && d.editsToday <= 100
        : (d.get('editDay','') == old.get('editDay','') && d.get('editsToday',0) == old.get('editsToday',0))
          || (old.get('editDay','') != today() && d.get('editDay','') == today() && d.get('editsToday',0) == 0);
    }
    function interactionAction(a) { return a in ['shake','comet','shootingStar']; }
    function interactionBudget(d, old) {
      return interactionAction(d.action)
        ? d.get('interactionDay','') == today() && d.get('interactionsToday',0) is int
          && d.interactionsToday == (old.get('interactionDay','') == today() ? old.get('interactionsToday',0) + 1 : 1)
          && d.interactionsToday <= 10
        : d.get('interactionDay','') == old.get('interactionDay','')
          && d.get('interactionsToday',0) == old.get('interactionsToday',0);
    }
    function cooldowns(d, old) {
      return (d.action == 'shake' ? d.lastShakeAt == request.time && request.time >= old.lastShakeAt + duration.value(10,'s') : d.lastShakeAt == old.lastShakeAt)
        && (d.action == 'comet' ? d.lastCometAt == request.time && request.time >= old.lastCometAt + duration.value(10,'s') : d.lastCometAt == old.lastCometAt)
        && (d.action == 'shootingStar' ? d.lastStarAt == request.time && request.time >= old.lastStarAt + duration.value(20,'s') : d.lastStarAt == old.lastStarAt);
    }
    match /objects/{objectId} {
      // Signed screen: active query. Owner: own active/hangar query or document.
      allow list: if signed() && (resource.data.status == 'active' || own(resource.data.ownerUid));
      // D6: signed screens fetch moon host planets by ID; no public collection access.
      allow get: if signed() && (resource.data.type == 'planet' || resource.data.status == 'active' || own(resource.data.ownerUid));
      allow create: if signed() && createObject(request.resource.data, objectId);
      allow update: if own(resource.data.ownerUid) && updateObject(request.resource.data, resource.data, objectId);
    }
    function createObject(d, objectId) {
      let u = afterUser();
      let flags = config();
      return objectSchema(d) && freshOrbit(d.orbit) && u.lastWriteAt == request.time
        && flags.seasonOpen && flags.launches && validHost(d)
        && d.createdAt == request.time && d.status == 'active'
        && u.activeObjectId == objectId && u.action == 'launch'
        && eventMatches(u.writeId + '-create', 'create', objectId);
    }
    function updateObject(d, old, objectId) {
      let u = afterUser();
      let flags = config();
      return objectSchema(d) && u.lastWriteAt == request.time && flags.seasonOpen
        && (d.orbit == old.orbit || freshOrbit(d.orbit))
        && d.ownerUid == old.ownerUid && d.type == old.type && d.createdAt == old.createdAt
        && d.season == old.season
        && d.schemaVersion >= old.schemaVersion
        && d.get('hostOrbit',null) == old.get('hostOrbit',null)
        && (d.status == 'hangar'
          ? old.status == 'active' && launchAction(u.action)
            && get(userPath()).data.activeObjectId == objectId && u.activeObjectId != objectId
            && d.diff(old).affectedKeys().hasOnly(['status','updatedAt'])
          : u.activeObjectId == objectId
            && ((u.action == 'edit' && old.status == 'active' && d.orbit == old.orbit)
              || (u.action == 'relaunch' && old.status == 'hangar' && flags.launches
                && d.diff(old).affectedKeys().hasOnly(['status','updatedAt']) && validHost(d))));
    }

    function initialInteractionClocks(d) {
      return d.lastShakeAt == (d.action == 'shake' ? request.time : timestamp.value(0))
        && d.lastCometAt == (d.action == 'comet' ? request.time : timestamp.value(0))
        && d.lastStarAt == (d.action == 'shootingStar' ? request.time : timestamp.value(0));
    }
    match /users/{uid} {
      allow get: if own(uid);
      allow create: if own(uid) && userSchema(request.resource.data) && request.resource.data.launchDay == today()
        && request.resource.data.get('editsToday',0) == 0
        && request.resource.data.get('editDay',today()) == today()
        && (request.resource.data.action == 'launch'
          ? request.resource.data.lastShakeAt == timestamp.value(0)
            && request.resource.data.lastCometAt == timestamp.value(0) && request.resource.data.lastStarAt == timestamp.value(0)
            && request.resource.data.launchesToday == 1 && request.resource.data.get('interactionsToday',0) == 0
            && request.resource.data.get('interactionDay',today()) == today() && activeTransition(request.resource.data, '')
          : interactionAction(request.resource.data.action) && request.resource.data.launchesToday == 0
            && request.resource.data.activeObjectId == ''
            && interactionBudget(request.resource.data, {})
            && initialInteractionClocks(request.resource.data)
            && eventMatches(request.resource.data.writeId, request.resource.data.action, ''));
      allow update: if own(uid) && userSchema(request.resource.data)
        && request.time >= resource.data.lastWriteAt + duration.value(2,'s')
        && request.resource.data.writeId != resource.data.writeId
        && cooldowns(request.resource.data, resource.data)
        && editBudget(request.resource.data, resource.data)
        && interactionBudget(request.resource.data, resource.data)
        && (launchAction(request.resource.data.action)
          ? request.resource.data.launchDay == today() && request.resource.data.launchDay >= resource.data.launchDay
            && request.resource.data.launchesToday == (resource.data.launchDay == today() ? resource.data.launchesToday + 1 : 1)
            && activeTransition(request.resource.data, resource.data.activeObjectId)
          : request.resource.data.activeObjectId == resource.data.activeObjectId
            && request.resource.data.launchDay == resource.data.launchDay
            && request.resource.data.launchesToday == resource.data.launchesToday
            && eventMatches(request.resource.data.writeId, request.resource.data.action, resource.data.activeObjectId));
    }
    function objectPayload(d) { return d.payload == getAfter(objectPath(d.objectId)).data; }
    function allowedEvent(d, eventId, u) {
      return (d.type == 'create' && eventId == u.writeId + '-create' && u.action == 'launch'
          && d.objectId == u.activeObjectId && objectPayload(d))
        || (d.type == 'crumble' && eventId == u.writeId + '-crumble' && launchAction(u.action)
          && d.objectId == get(userPath()).data.activeObjectId && objectPayload(d))
        || (eventId == u.writeId && d.type == u.action && d.objectId == u.activeObjectId
          && ((d.type in ['launch','relaunch','edit'] && objectPayload(d)
              && d.payload.updatedAt == request.time)
            || (d.type == 'shake' && interactionEnabled('shake') && d.payload.keys().size() == 0)
            || (d.type == 'comet' && interactionEnabled('comets') && d.payload.keys().hasAll(['dx','dy']) && d.payload.keys().hasOnly(['dx','dy'])
                && numberIn(d.payload.dx,-1,1) && numberIn(d.payload.dy,-1,1)
                && d.payload.dx * d.payload.dx + d.payload.dy * d.payload.dy >= 0.01)
            || (d.type == 'shootingStar' && interactionEnabled('shootingStars') && d.payload.keys().hasAll(['messageKey'])
                && d.payload.keys().hasOnly(['messageKey']) && d.payload.messageKey in ['hello','together','wonder','wish','orbit','stardust','helloEarth','explore','bright','beyond','dream','thanks'])));
    }
    function interactionEnabled(flag) {
      let flags = config();
      return flags.seasonOpen && flags[flag];
    }
    function validEvent(d, eventId) {
      let u = afterUser();
      return u.lastWriteAt == request.time
        && d.keys().hasAll(['schemaVersion','type','objectId','uid','at','payload'])
        && d.keys().hasOnly(['schemaVersion','type','objectId','uid','at','payload'])
        && d.schemaVersion == 1 && d.uid == request.auth.uid
        && d.at == request.time && (id(d.objectId) || (interactionAction(d.type) && d.objectId == ''))
        && d.payload is map && allowedEvent(d, eventId, u);
    }
    match /events/{eventId} {
      // A moving, bounded recent window only. Never expose the season event history.
      allow list: if signed() && request.query.limit != null && request.query.limit <= 100
        && resource.data.at > request.time - duration.value(120, 's');
      allow create: if signed() && validEvent(request.resource.data, eventId);
    }
    match /seasons/{season}/meta/{document} { allow get: if season == 'bad-2026' && document == 'manifest'; }
    match /seasons/{season}/log/{chunk} { allow get: if season == 'bad-2026'; }
    match /snapshots/{snapshotId} { allow get: if snapshotId == 'live'; }
    match /config/{configId} { allow get: if signed() && configId == 'live'; }
    // Assistant remains unavailable in this milestone; clients cannot create inbox/outbox docs.
    match /{document=**} { allow read, write: if false; }
  }
}
