rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && uid == request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function objectPath(id) { return /databases/$(database)/documents/objects/$(id); }
    function eventPath(id) { return /databases/$(database)/documents/events/$(id); }
    function config() { return get(/databases/$(database)/documents/config/live).data; }
    function afterUser() { return getAfter(userPath()).data; }
    function numberIn(n, low, high) { return n is number && n >= low && n <= high; }
    function id(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function paletteIndex(n) { return n is int && n >= 0 && n <= 3; }
    function params(p, type, version) {
      return p is map && numberIn(p.size, 0.2, 0.7) && (
        (type == 'planet'
          && p.keys().hasAll(version == 1 ? ['size','palette','oceans'] : ['size','palette','oceans','mountains','clouds','rings','atmosphere'])
          && p.keys().hasOnly(['size','palette','oceans','mountains','clouds','rings','atmosphere'])
          && paletteIndex(p.palette) && numberIn(p.oceans,0,1)
          && numberIn(p.get('mountains',0.3),0,1) && numberIn(p.get('clouds',0.3),0,1)
          && numberIn(p.get('rings',0),0,1) && paletteIndex(p.get('atmosphere',0)))
        || (version == 2 && type == 'star' && p.keys().hasAll(['size','temperature','corona'])
          && p.keys().hasOnly(['size','temperature','corona']) && numberIn(p.temperature,0,1) && numberIn(p.corona,0,1))
        || (version == 2 && type == 'moon' && p.keys().hasAll(['size','craters','colour'])
          && p.keys().hasOnly(['size','craters','colour']) && numberIn(p.craters,0,1) && paletteIndex(p.colour)));
    }
    function validHost(d) {
      return d.type == 'star' ? d.orbit.hostId == 'central'
        : d.type == 'planet' ? (d.orbit.hostId == 'central' || get(objectPath(d.orbit.hostId)).data.type == 'star')
        : d.orbit.hostId != 'central'
          && get(objectPath(d.orbit.hostId)).data.type == 'planet'
          && get(objectPath(d.orbit.hostId)).data.ownerUid in [request.auth.uid, '']
          && d.hostOrbit == get(objectPath(d.orbit.hostId)).data.orbit;
    }
    function orbit(o) {
      return o.keys().hasAll(['hostId','a','e','inclination','omega','meanAnomaly','epoch','direction','isComet'])
        && o.keys().hasOnly(['hostId','a','e','inclination','omega','meanAnomaly','epoch','direction','isComet'])
        && id(o.hostId) && numberIn(o.a, 2, 30) && numberIn(o.e, 0, 0.8)
        && o.a * (1 - o.e) > 1 && numberIn(o.inclination, -0.35, 0.35)
        && numberIn(o.omega, -3.141592653589793, 3.141592653589793)
        && numberIn(o.meanAnomaly, -6.283185307179586, 6.283185307179586)
        && numberIn(o.epoch, 0, 4102444800000) && o.direction in [-1,1] && o.isComet is bool;
    }
    function objectSchema(d) {
      return d.keys().hasAll(['schemaVersion','ownerUid','type','nameKey','params','orbit','status','createdAt','updatedAt','season'])
        && d.keys().hasOnly(['schemaVersion','ownerUid','type','nameKey','params','orbit','hostOrbit','status','createdAt','updatedAt','season'])
        && d.schemaVersion in [1,2] && d.ownerUid == request.auth.uid && d.type in ['planet','star','moon']
        && (d.nameKey in ['quiet-aurora','bright-tide','gentle-horizon','distant-garden'] || (d.nameKey is string && d.nameKey.matches('^n[0-3][0-9]-[0-3][0-9]$')))
        && params(d.params,d.type,d.schemaVersion) && orbit(d.orbit)
        && (d.type == 'moon' ? orbit(d.hostOrbit) : !('hostOrbit' in d)) && d.status in ['active','hangar']
        && d.createdAt is timestamp && d.updatedAt == request.time && d.season == 'bad-2026';
    }
    function freshBatch() { return afterUser().lastWriteAt == request.time; }
    function launchAction(a) { return a in ['launch','relaunch']; }
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function today() { return string(request.time.year()) + '-' + pad(request.time.month()) + '-' + pad(request.time.day()); }
    function eventMatches(eventId, type, objectId) {
      let e = getAfter(eventPath(eventId)).data;
      return e.at == request.time && e.uid == request.auth.uid && e.type == type && e.objectId == objectId;
    }
    function activeTransition(d, oldId) {
      let o = getAfter(objectPath(d.activeObjectId)).data;
      return o.ownerUid == request.auth.uid && o.status == 'active' && o.updatedAt == request.time
        && eventMatches(d.writeId, d.action, d.activeObjectId)
        && (oldId == '' || (oldId != d.activeObjectId
          && getAfter(objectPath(oldId)).data.status == 'hangar'
          && getAfter(objectPath(oldId)).data.updatedAt == request.time
          && eventMatches(d.writeId + '-crumble', 'crumble', oldId)));
    }
    function userSchema(d) {
      return d.keys().hasAll(['schemaVersion','activeObjectId','launchesToday','launchDay','lastWriteAt','lastShakeAt','lastCometAt','lastStarAt','writeId','action'])
        && d.keys().hasOnly(['schemaVersion','activeObjectId','launchesToday','launchDay','lastWriteAt','lastShakeAt','lastCometAt','lastStarAt','writeId','action'])
        && d.schemaVersion == 1 && id(d.activeObjectId) && id(d.writeId)
        && d.launchesToday is int && d.launchesToday >= 1 && d.launchesToday <= 5
        && d.launchDay is string && d.lastWriteAt == request.time
        && d.lastShakeAt is timestamp && d.lastCometAt is timestamp && d.lastStarAt is timestamp
        && d.action in ['launch','relaunch','edit','shake','comet','shootingStar'];
    }
    function cooldowns(d, old) {
      return (d.action == 'shake' ? d.lastShakeAt == request.time && request.time >= old.lastShakeAt + duration.value(10,'s') : d.lastShakeAt == old.lastShakeAt)
        && (d.action == 'comet' ? d.lastCometAt == request.time && request.time >= old.lastCometAt + duration.value(10,'s') : d.lastCometAt == old.lastCometAt)
        && (d.action == 'shootingStar' ? d.lastStarAt == request.time && request.time >= old.lastStarAt + duration.value(20,'s') : d.lastStarAt == old.lastStarAt);
    }
    match /objects/{objectId} {
      // Public screen queries MUST constrain status == active; hangar is owner-only.
      allow read: if resource.data.status == 'active' || own(resource.data.ownerUid);
      allow create: if signed() && objectSchema(request.resource.data) && freshBatch()
        && config().seasonOpen && config().launches
        && validHost(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'active'
        && afterUser().activeObjectId == objectId && afterUser().action == 'launch'
        && eventMatches(afterUser().writeId + '-create', 'create', objectId);
      allow update: if own(resource.data.ownerUid) && objectSchema(request.resource.data) && freshBatch()
        && config().seasonOpen
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.season == resource.data.season
        && request.resource.data.schemaVersion >= resource.data.schemaVersion
        && request.resource.data.get('hostOrbit',null) == resource.data.get('hostOrbit',null)
        && (request.resource.data.status == 'hangar'
          ? resource.data.status == 'active' && launchAction(afterUser().action)
            && get(userPath()).data.activeObjectId == objectId && afterUser().activeObjectId != objectId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          : afterUser().activeObjectId == objectId
            && ((afterUser().action == 'edit' && resource.data.status == 'active'
                && request.resource.data.orbit == resource.data.orbit)
              || (afterUser().action == 'relaunch' && resource.data.status == 'hangar' && config().launches
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && validHost(request.resource.data))));
    }
    match /users/{uid} {
      allow get: if own(uid);
      allow create: if own(uid) && userSchema(request.resource.data) && request.resource.data.action == 'launch'
        && request.resource.data.launchesToday == 1 && request.resource.data.launchDay == today()
        && request.resource.data.lastShakeAt == timestamp.value(0)
        && request.resource.data.lastCometAt == timestamp.value(0) && request.resource.data.lastStarAt == timestamp.value(0)
        && activeTransition(request.resource.data, '');
      allow update: if own(uid) && userSchema(request.resource.data)
        && request.time >= resource.data.lastWriteAt + duration.value(2,'s')
        && request.resource.data.writeId != resource.data.writeId
        && cooldowns(request.resource.data, resource.data)
        && (launchAction(request.resource.data.action)
          ? request.resource.data.launchDay == today() && request.resource.data.launchDay >= resource.data.launchDay
            && request.resource.data.launchesToday == (resource.data.launchDay == today() ? resource.data.launchesToday + 1 : 1)
            && activeTransition(request.resource.data, resource.data.activeObjectId)
          : request.resource.data.activeObjectId == resource.data.activeObjectId
            && request.resource.data.launchDay == resource.data.launchDay
            && request.resource.data.launchesToday == resource.data.launchesToday
            && eventMatches(request.resource.data.writeId, request.resource.data.action, resource.data.activeObjectId));
    }
    function objectPayload(d) { return d.payload == getAfter(objectPath(d.objectId)).data; }
    function allowedEvent(d, eventId) {
      let u = afterUser();
      return (d.type == 'create' && eventId == u.writeId + '-create' && u.action == 'launch'
          && d.objectId == u.activeObjectId && !exists(objectPath(d.objectId)) && objectPayload(d))
        || (d.type == 'crumble' && eventId == u.writeId + '-crumble' && launchAction(u.action)
          && d.objectId == get(userPath()).data.activeObjectId && objectPayload(d))
        || (eventId == u.writeId && d.type == u.action && d.objectId == u.activeObjectId
          && ((d.type in ['launch','relaunch','edit'] && objectPayload(d)
              && getAfter(objectPath(d.objectId)).data.updatedAt == request.time
              && (d.type != 'launch' || !exists(objectPath(d.objectId))))
            || (d.type == 'shake' && config().shake && d.payload.keys().size() == 0)
            || (d.type == 'comet' && config().comets && d.payload.keys().hasAll(['dx','dy']) && d.payload.keys().hasOnly(['dx','dy'])
                && numberIn(d.payload.dx,-1,1) && numberIn(d.payload.dy,-1,1))
            || (d.type == 'shootingStar' && config().shootingStars && d.payload.keys().hasAll(['messageKey'])
                && d.payload.keys().hasOnly(['messageKey']) && d.payload.messageKey in ['hello','together','wonder'])));
    }
    match /events/{eventId} {
      allow create: if signed() && config().seasonOpen && freshBatch()
        && request.resource.data.keys().hasAll(['schemaVersion','type','objectId','uid','at','payload'])
        && request.resource.data.keys().hasOnly(['schemaVersion','type','objectId','uid','at','payload'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time && id(request.resource.data.objectId)
        && request.resource.data.payload is map && allowedEvent(request.resource.data, eventId);
    }
    match /snapshots/{snapshotId} { allow get: if snapshotId == 'live'; }
    match /config/{configId} { allow get: if configId == 'live'; }
    // Assistant remains unavailable in this milestone; clients cannot create inbox/outbox docs.
    match /{document=**} { allow read, write: if false; }
  }
}
