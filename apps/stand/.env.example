# Optional server-side setup. Export this variable before starting the stand;
# the stand does not automatically load .env files.
# TODO(operator): supply the path on the booth laptop, never inline key contents.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/data-project-service-account.json
# TODO(operator): export the exact project ID used by VITE_FIREBASE_PROJECT_ID.
# Required with credentials; a display name is not a project ID.
FIREBASE_PROJECT_ID=

# Emulator-only alternative: no credential variable is needed.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-little-galaxy
