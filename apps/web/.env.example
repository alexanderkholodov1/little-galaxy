# Build rehearsal placeholders only; replace with the data project's public web config.
VITE_FIREBASE_API_KEY=example-public-web-key
VITE_FIREBASE_AUTH_DOMAIN=example-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=example-project
VITE_FIREBASE_STORAGE_BUCKET=example-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:example
# Local development only: uncomment to use the demo project and local emulators.
# VITE_USE_EMULATORS=1
# Production builds reject VITE_USE_EMULATORS whenever it is set, even to an empty value.
