{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".tmp/admin-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/little-galaxy/admin{,/**}",
        "destination": "/little-galaxy/admin.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://alexanderkholodov.web.app/little-galaxy/",
        "type": 302
      },
      {
        "source": "/little-galaxy",
        "destination": "https://alexanderkholodov.web.app/little-galaxy/",
        "type": 302
      },
      {
        "source": "/little-galaxy/",
        "destination": "https://alexanderkholodov.web.app/little-galaxy/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/little-galaxy/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
